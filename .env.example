# Claude Virtual Agents — 設定サンプル
#
# このファイルを `.env` にコピーして値を書き換えてください。
#   Windows (PowerShell):  copy .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# .env は Git 管理外(.gitignore 済み)です。
# サーバー・Hook レポーター・テストスクリプトがすべて同じ .env を読むため、
# ここに書けば全体に反映されます。
#
# 優先順位: コマンド引数(--port= / --boss= / --idle=)> 実際の環境変数 > .env > 既定値

# 待ち受けポート(既定: 3777)
# 変更後は http://127.0.0.1:<この値> を開いてください。
CVA_PORT=3777

# メインエージェントの呼び名(既定: BOSS)
# 例: 社長 / 部長 / オレ / Boss
# ブラウザの ?boss= パラメータを付けた場合はそちらが優先されます。
CVA_BOSS_NAME=BOSS

# 待機が続いて充電に入るまでの秒数(既定: 60)
# メインは応答が終わるとすぐ充電ステーションで待機し、これを過ぎると充電に入ります。
# サブはこれを過ぎると手待ちになります。
# 短くすると「応答完了 → 待機 → 充電」の流れをすぐ試せます。
CVA_IDLE_SEC=60

# サブエージェントの定義名 → 名札に出す表示名(既定: ガンダムシリーズの名前)
# Claude Code のエージェント定義名は英小文字とハイフンのみなので、日本語で
# 呼びたい場合はここで読み替えます。`定義名:表示名` をカンマ区切りで並べます。
# 既定に無い定義名を足す・既定を上書きする、どちらもできます。
# 表に無い定義名は、その定義名がそのまま名札に出ます。
# CVA_AGENT_NAMES=sayla:セイラ,my-agent:調査班
